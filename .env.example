# Copy to .env (local) and add the same variable in Vercel →
# Project → Settings → Environment Variables, then redeploy.

# Web3Forms access key for the /pricing lead email (https://web3forms.com).
# Every PDF proposal download sends the client's details + package to the
# email address registered with this key. Leave empty to send nothing.
# This key is public by design (it ships to the browser); it only allows
# sending form submissions to your inbox.
VITE_WEB3FORMS_KEY=
